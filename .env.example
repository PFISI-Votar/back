# Aplicación
DEVELOPMENT=true
PORT=3000
FRONTEND_URL=http://localhost:5173

# En producción: DEVELOPMENT=false y REQUIRE_HTTPS=true (TLS 1.3 en reverse proxy)
REQUIRE_HTTPS=false

# Rate limit tiers (requests per window, per IP)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=1000
RATE_LIMIT_VOTE_MAX=5
RATE_LIMIT_VOTE_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=votar

# Dev bootstrap — credenciales UTN para registrar tu usuario como ELECTION_ADMIN
# (solo si aún no hay admin o querés reemplazar el placeholder de migración)
DEV_ADMIN_NICK=
DEV_ADMIN_PASSWORD=


JWT_ISSUER=https://votar.local/idp
JWT_AUDIENCE=votar-api
JWT_ACCESS_EXPIRES_IN=15m
JWT_VOTER_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=8h
AUTOGESTION_BASE_URL=https://webservice.frvm.utn.edu.ar/autogestion
JWT_JWKS_URI=


AUDIT_OBFUSCATION_SALT=votar-audit-dev-salt


#Blockchain (VOTAR-335)
#Para trabajar con hardhat local, hacer `npm run dev` en el repo de blockchain y trabajar con el archivo `.env.blockchain.local` 
#(y configurar LOAD_BLOCKCHAIN_LOCAL=true). Ignorar esto para Sepolia.
LOAD_BLOCKCHAIN_LOCAL=false

#Para trabajar en SEPOLIA TESTNET, ejecutar el script del repo de blockchain (en scripts/init-sepolia-contracts, ver README.md)
SEPOLIA_RPC_URL=completar_con_alchemy_instructivo_en_repo_blockchain
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io
CHAIN_ID=11155111
ADMIN_MULTISIG_ADDRESS=ejecutar_deploy-sepolia-stack.ts_repo_blockchain
PRIVATE_KEY=private_key

ELECTION_FACTORY_ADDRESS=ejecutar_deploy-sepolia-stack.ts_repo_blockchain
MERKLE_ROOT_STORE_ADDRESS=ejecutar_deploy-sepolia-stack.ts_repo_blockchain



#                                                                #
#   OTRAS VARIABLES - No necesarias para trabajar en develop     #
#                                                                #

#Legacy (ya no firma/verifica access tokens RS256; se puede omitir):
#JWT_SECRET=

#Innecesaria. Es una variable opcional usada para desplegar un nuevo contrato ballot si falta, pero esto ya se hace al crear el comicio.
#BALLOT_CONTRACT_ADDRESS=

#VOTAR-380 — CORS whitelist (comma-separated). Empty = FRONTEND_URL only.
#CORS_ALLOWED_ORIGINS=http://localhost:5173,https://votar.example.com

#Opcional: PEM PKCS8 / SPKI para firmar de forma estable entre reinicios (solo Modo A)
#JWT_PRIVATE_KEY=
#JWT_PUBLIC_KEY=
#JWT_KID=votar-bff-1

#VOTAR-337 — sync de ElectionFactory (address + ABI) a PostgreSQL
#Tras `npm run deploy:factory:sepolia` en blockchain/: npm run sync:election-factory
#ELECTION_FACTORY_NETWORK=sepolia
#ELECTION_FACTORY_ARTIFACT_PATH=../blockchain/deployments/sepolia/ElectionFactory.json

# VOTAR-387 — Aprovisionamiento de gas para wallets de prueba (Sepolia)
FAUCET_ENABLED=false
FAUCET_MASTER_PRIVATE_KEY=
TEST_WALLET_ADDRESSES=0x111...,0x222...,0x333...
FAUCET_MIN_BALANCE_ETH=0.1
FAUCET_TOPUP_TARGET_ETH=0.1

# Notificaciones por mail (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=