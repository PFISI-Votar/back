# Application
DEVELOPMENT=true
PORT=3000
FRONTEND_URL=http://localhost:5173
# En producción: DEVELOPMENT=false y REQUIRE_HTTPS=true (TLS 1.3 en reverse proxy)
REQUIRE_HTTPS=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=votar

# Auth (US-313) — BFF: access corto + refresh en cookie HttpOnly
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_VOTER_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=8h
AUTOGESTION_BASE_URL=https://webservice.frvm.utn.edu.ar/autogestion

# Blockchain (US-335) — publicación Merkle root en Sepolia
SEPOLIA_RPC_URL=
MERKLE_ROOT_STORE_ADDRESS=
MERKLE_UPDATER_PRIVATE_KEY=
CHAIN_ID=11155111
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io
