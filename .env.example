# Application
DEVELOPMENT=true
PORT=3000
FRONTEND_URL=http://localhost:5173
# En producción: DEVELOPMENT=false y REQUIRE_HTTPS=true (TLS 1.3 en reverse proxy)
REQUIRE_HTTPS=false

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=votar

# Dev bootstrap — credenciales UTN para registrar tu usuario como ELECTION_ADMIN
# (solo si aún no hay admin o querés reemplazar el placeholder de migración)
DEV_ADMIN_NICK=
DEV_ADMIN_PASSWORD=

# VOTAR-314 — protección de identidad (RS256 + JWKS + claims iss/aud/exp)
#
# Modo A (default / Sprint actual): JWT_JWKS_URI vacío
#   → BFF firma RS256, publica /auth/.well-known/jwks.json y verifica contra esas claves
# Modo B (SSO institucional): JWT_JWKS_URI=<jwks del IdP>
#   → Solo verifica tokens emitidos por el IdP; NO combinar con firma local del BFF
#     (login BFF rechaza emisión local; el endpoint JWKS local responde 404)
JWT_ISSUER=https://votar.local/idp
JWT_AUDIENCE=votar-api
JWT_ACCESS_EXPIRES_IN=15m
JWT_VOTER_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=8h
JWT_JWKS_URI=
# Opcional: PEM PKCS8 / SPKI para firmar de forma estable entre reinicios (solo Modo A)
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_KID=votar-bff-1
# Legacy (ya no firma/verifica access tokens RS256; se puede omitir):
# JWT_SECRET=
AUTOGESTION_BASE_URL=https://webservice.frvm.utn.edu.ar/autogestion

# VOTAR-370 — sal de ofuscación para actor/terminal del audit log institucional
AUDIT_OBFUSCATION_SALT=votar-audit-dev-salt

#Blockchain (US-335)
# En dev local, `npm run dev` en blockchain/ genera automáticamente `.env.blockchain.local`.
# Para Sepolia/testnet, completá manualmente en `.env`:
SEPOLIA_RPC_URL=
MERKLE_ROOT_STORE_ADDRESS=
MERKLE_UPDATER_PRIVATE_KEY=
ELECTION_ADMIN_PRIVATE_KEY=
BALLOT_CONTRACT_ADDRESS=
# Clave privada del sistema de auditoría para FirmaDigital de recibos (VOTAR-360).
# Nunca se almacena el PDF; solo se firma el payload canónico ElectionID|txHash|block|timestamp.
RECIBO_SIGNING_PRIVATE_KEY=
CHAIN_ID=11155111
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io
