# Aplicación
DEVELOPMENT=true
PORT=3000
FRONTEND_URL=http://localhost:5173

# En producción: DEVELOPMENT=false y REQUIRE_HTTPS=true (TLS 1.3 en reverse proxy)
REQUIRE_HTTPS=false

# Rate limit tiers (requests per window, per IP)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=1000
RATE_LIMIT_VOTE_MAX=5
RATE_LIMIT_VOTE_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=votar

# Dev bootstrap — credenciales UTN para registrar tu usuario como ELECTION_ADMIN
# (solo si aún no hay admin o querés reemplazar el placeholder de migración)
DEV_ADMIN_NICK=legajo
DEV_ADMIN_PASSWORD=contra_autogestion


JWT_ISSUER=https://votar.local/idp
JWT_AUDIENCE=votar-api
JWT_SECRET=dev-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_VOTER_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=8h
AUTOGESTION_BASE_URL=https://webservice.frvm.utn.edu.ar/autogestion
JWT_JWKS_URI=


AUDIT_OBFUSCATION_SALT=votar-audit-dev-salt


#Blockchain (US-335)
# En dev local, `npm run dev` en blockchain/ genera automáticamente `.env.blockchain.local`.
# Para Sepolia/testnet, completá manualmente en `.env`:
SEPOLIA_RPC_URL=completar_con_instructivo_en_repo_blockchain
ELECTION_FACTORY_ADDRESS=ejecutar_deploy-sepolia-stack.ts_repo_blockchain
MERKLE_ROOT_STORE_ADDRESS=ejecutar_deploy-sepolia-stack.ts_repo_blockchain
MERKLE_UPDATER_PRIVATE_KEY=private_key
ELECTION_ADMIN_PRIVATE_KEY=private_key

# VOTAR-364 — fallback AuditView cuando ElectionFactory no tiene deployment del comicio.
# En local, `npm run deploy:local` en blockchain/ escribe AUDIT_VIEW_ADDRESS en .env.blockchain.local.
AUDIT_VIEW_ADDRESS=multisig_address

# Clave privada del sistema de auditoría para FirmaDigital de recibos (VOTAR-360).
# Nunca se almacena el PDF; solo se firma el payload canónico ElectionID|txHash|block|timestamp.
RECIBO_SIGNING_PRIVATE_KEY=multisig_address
CHAIN_ID=11155111
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io