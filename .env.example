# Application
DEVELOPMENT=true
PORT=3000
FRONTEND_URL=http://localhost:5173
# En producción: DEVELOPMENT=false y REQUIRE_HTTPS=true (TLS 1.3 en reverse proxy)
REQUIRE_HTTPS=false

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=votar

# Dev bootstrap — credenciales UTN para registrar tu usuario como ELECTION_ADMIN
# (solo si aún no hay admin o querés reemplazar el placeholder de migración)
DEV_ADMIN_NICK=
DEV_ADMIN_PASSWORD=

JWT_SECRET=dev-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_VOTER_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=8h
AUTOGESTION_BASE_URL=https://webservice.frvm.utn.edu.ar/autogestion

#Blockchain (US-335)
# En dev local, `npm run dev` en blockchain/ genera automáticamente `.env.blockchain.local`.
# Para Sepolia/testnet, completá manualmente en `.env`:
SEPOLIA_RPC_URL=
MERKLE_ROOT_STORE_ADDRESS=
MERKLE_UPDATER_PRIVATE_KEY=
ELECTION_ADMIN_PRIVATE_KEY=
BALLOT_CONTRACT_ADDRESS=
ELECTION_FACTORY_ADDRESS=
# Clave privada del sistema de auditoría para FirmaDigital de recibos (VOTAR-360).
# Nunca se almacena el PDF; solo se firma el payload canónico ElectionID|txHash|block|timestamp.
RECIBO_SIGNING_PRIVATE_KEY=
CHAIN_ID=11155111
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io

# VOTAR-337 — sync de ElectionFactory (address + ABI) a PostgreSQL
# Tras `npm run deploy:factory:sepolia` en blockchain/:
#   npm run sync:election-factory
# ELECTION_FACTORY_NETWORK=sepolia
# ELECTION_FACTORY_ARTIFACT_PATH=../blockchain/deployments/sepolia/ElectionFactory.json
