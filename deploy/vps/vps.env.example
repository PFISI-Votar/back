# VOTAR-516 — configuración del VPS bajo demanda (Opción B de Impacto Ambiental).
#
# Copiar a /etc/votar/vps.env (lo hace provision.sh) y completar. Lo leen
# provision.sh e idle-shutdown.sh. No contiene secretos de la aplicación: esos
# viven en el .env del backend (BACK_ENV_FILE).

# --- Dominios (DNS apuntando a la IP pública del VPS antes de aprovisionar) ---
API_DOMAIN=api.votar.example.edu.ar
APP_DOMAIN=votar.example.edu.ar
# Mail para Let's Encrypt (avisos de vencimiento del certificado).
CERTBOT_EMAIL=

# --- Código fuente ---
BACK_REPO=https://github.com/PFISI-Votar/back.git
BACK_REF=master
FRONT_REPO=https://github.com/PFISI-Votar/front.git
FRONT_REF=master
# Variables de build del front (se pasan como --build-arg al Dockerfile).
FRONT_VITE_RPC_URL=
FRONT_VITE_RPC_FALLBACK_URLS=
# Orígenes RPC permitidos en la CSP del front (separados por espacio).
FRONT_RPC_ORIGINS=

# .env del backend ya completo (secretos reales). provision.sh lo copia a
# /opt/votar/back/.env y sobreescribe solo DB_HOST, DB_PORT, DB_SSL_* y PORT.
BACK_ENV_FILE=/root/votar-back.env

# --- Auto-apagado post-electoral ---
# Minutos sin tráfico HTTPS antes de apagar.
IDLE_MINUTES=60
# No apagar antes de este instante (ISO 8601). Ej: cierre del comicio + margen.
# Vacío = sin piso de fecha (solo rige el chequeo de estado de elecciones).
SHUTDOWN_NOT_BEFORE=2026-11-13T00:00:00-03:00
# Respaldo cifrado (npm run db:backup) antes de apagar. Si falla, NO se apaga.
BACKUP_BEFORE_SHUTDOWN=true
# Comando opcional para detener la instancia desde la API del proveedor
# (apagar el SO no siempre corta la facturación). Se ejecuta tras el respaldo
# y antes del poweroff. Ej: "hcloud server poweroff votar-prod"
SHUTDOWN_HOOK=
# true = registra la decisión pero no apaga (para probar en el VPS).
DRY_RUN=false
