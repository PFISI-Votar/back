# VOTAR-516 — corre el chequeo cada 5 minutos, empezando 15 minutos después
# del boot (deja levantar los servicios y evita apagar en el arranque).
[Unit]
Description=VOTAR: chequeo periodico de inactividad post-electoral

[Timer]
OnBootSec=15min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
