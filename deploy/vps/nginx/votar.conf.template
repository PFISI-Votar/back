# VOTAR-516 — reverse proxy TLS del VPS. provision.sh reemplaza
# __API_DOMAIN__ y __APP_DOMAIN__; certbot agrega los bloques :443 y la
# redirección HTTP -> HTTPS.
#
# Todo el tráfico se registra en votar-access.log: idle-shutdown.sh usa su
# fecha de modificación como señal de actividad.

server {
    listen 80;
    listen [::]:80;
    server_name __API_DOMAIN__;
    access_log /var/log/nginx/votar-access.log;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__;
    access_log /var/log/nginx/votar-access.log;

    location / {
        # Contenedor del front (front/deploy/Dockerfile), publicado solo en loopback.
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
